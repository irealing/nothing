{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nothing",
  "mainBinaryName": "Nothing",
  "version": "0.1.10",
  "identifier": "app.nothing.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nothing",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Nothing contributors",
    "copyright": "© 2026 Nothing contributors",
    "category": "Productivity",
    "shortDescription": "本地优先的加密表格工作区",
    "longDescription": "Nothing 是一款本地优先、SQLCipher 加密的 Notion 式纯表格工具，数据保存在标准 SQLite 文件中，不上传、无服务端。",
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "fileAssociations": [
      {
        "ext": ["nothing"],
        "description": "Nothing 加密工作区",
        "mimeType": "application/x-nothing",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
